// Cloudflare Workers config: serves the built app (dist/) as static assets.
// No server code; every unknown path falls back to index.html for the SPA.
{
  "name": "aria-new-task-app",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
